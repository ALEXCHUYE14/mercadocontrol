# === Supabase ===
# Copia este archivo a ".env.local" y rellena tus credenciales del panel de Supabase
# (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# === IA (opcional) ===
# Estas claves se usan SOLO en Supabase Edge Functions (nunca en el cliente).
# Se configuran con: supabase secrets set NOMBRE=valor
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
